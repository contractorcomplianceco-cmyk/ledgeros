# LedgerOS environment variables
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
#
# On Replit, DATABASE_URL and SESSION_SECRET are provided as managed secrets and
# PORT / BASE_PATH are injected by the artifact workflows — you do not set those
# by hand there. The list below is what LedgerOS actually reads from the
# environment; see README.md "Environment Variables" for details.

# ---- Required ----

# Postgres connection string used by the API server and Drizzle.
# Example: postgresql://user:password@host:5432/ledgeros
DATABASE_URL=

# Secret used to sign session cookies. REQUIRED in production — the server
# refuses to start in production (NODE_ENV=production) without it. Use a long,
# random value (e.g. `openssl rand -hex 32`). In development a temporary
# insecure fallback is used and a warning is logged.
SESSION_SECRET=

# ---- Optional / environment-provided ----

# Runtime mode: "development" (default) or "production". In production, secure
# cookies are enabled and SESSION_SECRET is mandatory.
NODE_ENV=development

# Port the API server binds to. Provided automatically by the Replit workflow;
# set manually only when running the API server outside Replit.
PORT=8080

# Log verbosity for the pino logger: fatal | error | warn | info | debug | trace.
# Defaults to "info".
LOG_LEVEL=info

# Base path the web app is served under. Provided automatically by the Replit
# web workflow at build time (exposed to the client as import.meta.env.BASE_URL).
# Set manually only when self-hosting the web app under a sub-path.
BASE_PATH=/

# ---- Future / not yet implemented ----
# LedgerOS does NOT currently integrate with Zoho, ADP, Navy Federal, SMTP, or an
# external Command Center service — none of these are referenced in the codebase,
# so no environment variables are required for them today. When those
# integrations are built, document their variables here (e.g. ZOHO_CLIENT_ID,
# ADP_CLIENT_ID, SMTP_HOST, ...) rather than committing unused placeholders.
